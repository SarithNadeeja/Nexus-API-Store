RewriteEngine On

# Protect sensitive files
<FilesMatch "^(config\.php|config\.sample\.php)$">
    Require all denied
</FilesMatch>

# API routes
RewriteRule ^api/public/apis$ api/index.php [L,QSA]
RewriteRule ^api/auth/register$ api/index.php [L,QSA]
RewriteRule ^api/auth/resend-verification$ api/index.php [L,QSA]
RewriteRule ^api/auth/login$ api/index.php [L,QSA]
RewriteRule ^api/auth/logout$ api/index.php [L,QSA]
RewriteRule ^api/auth/me$ api/index.php [L,QSA]
RewriteRule ^api/auth/verify$ api/index.php [L,QSA]
RewriteRule ^api/user/recharge$ api/index.php [L,QSA]
RewriteRule ^api/user/purchases$ api/index.php [L,QSA]

# Google OAuth aliases
RewriteRule ^oauth2/authorization/google$ oauth/google-start.php [L,QSA]

# Admin panel
RewriteRule ^nexus-admin/?$ nexus-admin/index.php [L,QSA]
RewriteRule ^nexus-admin/login/?$ nexus-admin/login.php [L,QSA]
RewriteRule ^nexus-admin/logout/?$ nexus-admin/logout.php [L,QSA]

# SPA-style HTML pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(login|dashboard|api-keys|about-us|verify-email)\.html$ - [L]

DirectoryIndex index.html index.php
